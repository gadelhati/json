# Ambiente virtual
venv/
.venv/

# Bytecode / cache do Python
__pycache__/
*.pyc

# Variáveis de ambiente
.env

# Dados gerados em tempo de execução (uploads e exports)
app/static/previews/*
app/data/uploads/*
app/data/exports/*
!app/static/previews/.gitkeep
!app/data/uploads/.gitkeep
!app/data/exports/.gitkeep
