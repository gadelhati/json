# Ambiente virtual
venv/
.venv/

# Bytecode / cache do Python
__pycache__/
*.pyc

# Variáveis de ambiente
.env

# Dados gerados em tempo de execução (uploads e exports)
app/data/exports/*
app/data/uploads/*

# Preservar diretórios e arquivos .gitkeep
!app/data/exports/.gitkeep
!app/data/uploads/.gitkeep
!app/data/uploads/geotiff/
!app/data/uploads/geotiff/.gitkeep

app/static/previews/*
uploads/*

.coverage
